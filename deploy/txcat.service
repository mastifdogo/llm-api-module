[Unit]
Description=txcat - LLM transaction category suggestions
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=txcat
Group=txcat
EnvironmentFile=-/etc/txcat/txcat.env
Environment=TXCAT_CONFIG=/etc/txcat/config.toml
ExecStart=/opt/txcat/venv/bin/txcat serve
Restart=on-failure
RestartSec=5
StateDirectory=txcat
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/txcat

[Install]
WantedBy=multi-user.target
